# SME Copilot (Gemini + optional Neon + Google Drive)

# Empty = demo mode (Daw Hla tools + fixed brief). Needed for live brief and pgvector embeddings.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-thinking-exp-01-21
GEMINI_EMBED_MODEL=text-embedding-004

# Neon Postgres with pgvector. Empty = in-memory P0 path still works.
DATABASE_URL=

# Google Drive Integration (set to 'true' to enable)
GOOGLE_DRIVE_ENABLED=false
